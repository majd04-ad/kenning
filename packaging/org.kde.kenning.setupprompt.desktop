[Desktop Entry]
Type=Application
Name=Face & Fingerprint setup prompt
Comment=Offers to set up face unlock once, if this computer has an infrared camera
Exec=/usr/lib/kenning/setup-prompt
OnlyShowIn=KDE;
NoDisplay=true
X-KDE-autostart-phase=2
