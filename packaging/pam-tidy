#
# Keeps PAM pointing only at face modules that are installed. Run by the package:
#   pam-tidy tidy | migrate | remove
#   pam-tidy settings <old config.ini>      (carries an earlier config.ini's settings into the installed one)
#   pam-tidy lockscreen on | off | status   (Plasma 6.8+: its kde-face service; older: the kde service)
set -eu

pam_dir=${PAM_DIR:-/etc/pam.d}
vendor_pam_dir=${VENDOR_PAM_DIR:-/usr/lib/pam.d}
kenning_dir=${KENNING_DIR:-/etc/kenning}
face_line='auth       sufficient                  pam_kenning.so'
lockscreen_dir=${LOCKSCREEN_DIR:-/usr/share/plasma/shells/org.kde.plasma.desktop/contents/lockscreen}
face_service=$pam_dir/kde-face
face_marker='# kenning: kde-fingerprint with pam_kenning.so in place of pam_fprintd.so; removed with Kenning'

# PAM files using a module on a non-comment line. Never kde-face, which is only written or removed whole.
files_using() {
    local file
    for file in "$pam_dir"/*; do
        [[ -f $file && ! -L $file && $file != "$face_service" ]] || continue
        awk -v m="$1" 'index($0, m) && $0 !~ /^[[:space:]]*#/ { found = 1 } END { exit !found }' "$file" && echo "$file"
    done
    return 0
}

rewrite() {
    local file=$1
    shift
    awk "$@" "$file" > "$file.kenning-new"
    chmod --reference="$file" "$file.kenning-new"
    chown --reference="$file" "$file.kenning-new"
    mv "$file.kenning-new" "$file"
}

drop_from() { # file module
    rewrite "$1" -v m="$2" '!(index($0, m) && $0 !~ /^[[:space:]]*#/)'
    echo "  kenning: removed $2 from $1"
}

drop() {
    local file
    for file in $(files_using "$1"); do
        drop_from "$file" "$1"
    done
}

uses() { # file module
    [[ -f $1 ]] && awk -v m="$2" 'index($0, m) && $0 !~ /^[[:space:]]*#/ { found = 1 } END { exit !found }' "$1"
}

# Carries the settings of an earlier config.ini into the installed one: the values of the keys
# the installed one has, so its comments stay and newer keys keep their defaults. For a
# config.ini the package manager set aside (pacman's config.ini.pacsave) when Kenning was
# removed, or replaced by another package of it, and installed again: without this the camera
# is forgotten, and face unlock fails until a new look is added.
carry_settings() { # old config
    local old=$1 config=$kenning_dir/config.ini
    [[ -s $old && -f $config ]] || return 1
    rewrite "$config" '
        function trim(text) { gsub(/^[[:space:]]+|[[:space:]]+$/, "", text); return text }
        { line = trim($0) }
        line ~ /^\[.*\]$/ { section = line }
        FNR == NR {
            if (line !~ /^[#;]/ && index(line, "=")) {
                old[section "/" trim(substr(line, 1, index(line, "=") - 1))] = trim(substr(line, index(line, "=") + 1))
            }
            next
        }
        line !~ /^[#;]/ && index(line, "=") {
            key = trim(substr(line, 1, index(line, "=") - 1))
            if ((section "/" key) in old) {
                print key " = " old[section "/" key]
                next
            }
        }
        { print }' "$old"
    echo "  kenning: kept the settings from $old"
}

# pam_faillock makes a failed attempt wait two seconds. That slows password guessing; a face that
# wasn't seen is no guess (the service has its own limit on those), and the wait only delays the
# lock screen's way back to the password.
no_fail_delay='
    $0 !~ /^[[:space:]]*#/ && /pam_faillock\.so/ && /preauth/ && !/nodelay/ { sub(/[[:space:]]+$/, ""); $0 = $0 " nodelay" }'

# Adds face unlock in front of a service's password check.
add_to() { # service
    local file=$pam_dir/$1
    if [[ ! -e $file ]]; then
        [[ -e $vendor_pam_dir/$1 ]] || return 0
        cp "$vendor_pam_dir/$1" "$file"
    fi
    uses "$file" pam_kenning.so && return 0
    rewrite "$file" -v line="$face_line" '!done && /^[[:space:]]*auth/ { print line; done = 1 } { print }'
    echo "  kenning: face unlock switched on in $file"
}

fingerprint_service() {
    local file
    for file in "$pam_dir/kde-fingerprint" "$vendor_pam_dir/kde-fingerprint"; do
        [[ -f $file ]] && uses "$file" pam_fprintd.so && echo "$file" && return 0
    done
    return 1
}

# Whether the lock screen has Plasma's own Face sign-in method (Plasma 6.8 and newer).
face_capable() {
    grep -q AuthenticatorModel "$lockscreen_dir/LockScreenUi.qml" 2> /dev/null || return 1
    local greeter found=
    for greeter in ${GREETER:-/usr/lib/kscreenlocker_greet /usr/libexec/kscreenlocker_greet /usr/lib/*/libexec/kscreenlocker_greet}; do
        [[ -f $greeter ]] && found=$greeter && break
    done
    [[ -n $found ]] && grep -aq kde-face "$found" || return 1
    fingerprint_service > /dev/null
}

face_service_ours() {
    [[ -f $face_service ]] && grep -qF "$face_marker" "$face_service"
}

# kde-face is kde-fingerprint with pam_kenning.so in place of pam_fprintd.so, failing closed (pam_deny.so behind it).
write_face_service() {
    if [[ -e $face_service ]] && ! face_service_ours; then
        echo "  kenning: $face_service exists and isn't Kenning's; leaving it" >&2
        return 1
    fi
    awk -v marker="$face_marker" "$no_fail_delay"'
        NR == 1 && /^#%PAM/ { print; print marker; next }
        NR == 1 { print marker }
        $0 !~ /^[[:space:]]*#/ && /pam_fprintd\.so/ {
            print "auth       [success=done default=die]  pam_kenning.so"
            print "auth       required                    pam_deny.so"
            next
        }
        { print }' "$(fingerprint_service)" > "$face_service.kenning-new"
    chmod 644 "$face_service.kenning-new"
    if cmp -s "$face_service.kenning-new" "$face_service"; then
        rm "$face_service.kenning-new"
    else
        mv "$face_service.kenning-new" "$face_service"
        echo "  kenning: wrote $face_service"
    fi
}

remove_face_service() {
    face_service_ours || return 0
    rm "$face_service"
    echo "  kenning: removed $face_service"
}

lockscreen() {
    case "$1" in
    on)
        if face_capable; then
            write_face_service || return 1
            uses "$pam_dir/kde" pam_kenning.so && drop_from "$pam_dir/kde" pam_kenning.so
        else
            add_to kde
        fi
        ;;
    off)
        remove_face_service
        uses "$pam_dir/kde" pam_kenning.so && drop_from "$pam_dir/kde" pam_kenning.so
        ;;
    status)
        if face_capable; then
            face_service_ours && echo "face on" || echo "face off"
        else
            uses "$pam_dir/kde" pam_kenning.so && echo "password on" || echo "password off"
        fi
        ;;
    *)
        echo "usage: $0 lockscreen on|off|status" >&2
        return 1
        ;;
    esac
    return 0
}

# After a Plasma upgrade or downgrade, keep lock screen face unlock on in the form this Plasma uses.
tidy_lockscreen() {
    if face_capable; then
        if uses "$pam_dir/kde" pam_kenning.so; then
            lockscreen on || true
            echo "  kenning: the lock screen now uses Plasma's Face sign-in method; it is switched on"
            echo "           for each user with a face model at their next login (or now, as that"
            echo "           user: /usr/lib/kenning/setup-prompt)"
        elif face_service_ours; then
            lockscreen on || true
        fi
    elif face_service_ours; then
        remove_face_service
        add_to kde
    fi
}

migrate() {
    local file service
    for file in $(files_using pam_faceunlock.so); do
        rewrite "$file" '$0 !~ /^[[:space:]]*#/ { sub(/pam_faceunlock\.so/, "pam_kenning.so") } { print }'
        echo "  kenning: $file now uses pam_kenning.so"
    done

    [[ -z $(files_using pam_kenning.so) ]] || return 0
    compgen -G "$kenning_dir/models/*.dat" > /dev/null || return 0
    # Same services as Set Up: an ordinary webcam stays off sudo.
    local services=(kde)
    [[ -e ${LOGIN_MANAGER_SUPPORT:-/usr/share/kenning/login-manager} ]] && services+=(plasmalogin)
    grep -Eq '^[[:space:]]*colour[[:space:]]*=[[:space:]]*true' "$kenning_dir/config.ini" 2>/dev/null || services+=(sudo)
    for service in "${services[@]}"; do
        add_to "$service"
    done
    tidy_lockscreen
}

case "${1:-}" in
tidy)
    [[ -e /usr/lib/security/pam_howdy.so ]] || drop pam_howdy.so
    tidy_lockscreen
    ;;
migrate)
    migrate
    ;;
settings)
    carry_settings "${2:?usage: $0 settings <old config.ini>}"
    ;;
remove)
    remove_face_service
    drop pam_kenning.so
    ;;
lockscreen)
    lockscreen "${2:-}"
    ;;
*)
    echo "usage: $0 tidy|migrate|remove|settings <old config.ini>|lockscreen on|off|status" >&2
    exit 1
    ;;
esac
