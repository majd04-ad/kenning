# At the first login after startup, offers to set up face unlock when there is an IR camera
# and no face model. Also switches on Plasma's Face and Fingerprint sign-in methods for users with
# a face model or a fingerprint, when Kenning provides them.

import fcntl
import getpass
import glob
import os
import socket
import struct
import subprocess
import sys
import time

# struct v4l2_fmtdesc: index, type, flags, description[32], pixelformat, mbus_code, reserved[3]
FMTDESC = struct.Struct("=III32sII12x")
VIDIOC_ENUM_FMT = 0xC0000000 | (FMTDESC.size << 16) | (ord("V") << 8) | 2
CAPTURE = 1
GREY = int.from_bytes(b"GREY", "little")
MAX_UPTIME = 600


def has_ir_camera() -> bool:
    """An IR sensor is the capture device that offers only greyscale frames."""
    for path in sorted(glob.glob("/dev/v4l/by-path/*-video-index0")):
        try:
            fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
        except OSError:
            continue
        formats = set()
        try:
            for index in range(32):
                request = bytearray(FMTDESC.pack(index, CAPTURE, 0, b"", 0, 0))
                try:
                    fcntl.ioctl(fd, VIDIOC_ENUM_FMT, request)
                except OSError:
                    break
                formats.add(FMTDESC.unpack(request)[4])
        finally:
            os.close(fd)
        if formats == {GREY}:
            return True
    return False


def ask_service(command: str, user: str) -> str | None:
    """The Kenning service's answer code, or None if it can't be reached."""
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as service:
            service.settimeout(5)
            service.connect("/run/kenning.sock")
            service.sendall(f"{command} {user}\n".encode())
            reply = service.recv(64).decode().strip()
    except (OSError, UnicodeDecodeError):
        return None
    return reply.split()[0] if reply else None


def has_face_model(user: str) -> bool | None:
    """Asks the face unlock service (face models are root-only); None if it can't be reached.
    A user locked out after too many failed attempts (14) has a model too, and so does one
    whose camera is switched off (17)."""
    reply = ask_service("has-model", user)
    return None if reply is None else reply in ("0", "14", "17")


def enable_face_method() -> None:
    """Face=true in the user's kscreenlockerrc, unless lock screen face unlock is off,
    Face is already set either way, or the user has no face model."""
    try:
        status = subprocess.run(["/usr/lib/kenning/pam-tidy", "lockscreen", "status"],
                                capture_output=True, text=True, timeout=10).stdout.strip()
        if status != "face on":
            return
        face = subprocess.run(["kreadconfig6", "--file", "kscreenlockerrc", "--group", "Authenticators", "--key", "Face"],
                              capture_output=True, text=True, timeout=10).stdout.strip()
        if face or not has_face_model(getpass.getuser()):
            return
        subprocess.run(["kwriteconfig6", "--file", "kscreenlockerrc", "--group", "Authenticators", "--key", "Face", "true"],
                       timeout=10)
    except (OSError, subprocess.SubprocessError):
        pass


def enable_fingerprint_method() -> None:
    """Fingerprint=true in the user's kscreenlockerrc when Kenning's Fingerprint method is on,
    Fingerprint isn't set either way and the user has a fingerprint."""
    try:
        status = subprocess.run(["/usr/lib/kenning/pam-tidy", "fingerprint", "status"],
                                capture_output=True, text=True, timeout=10).stdout.strip()
        if status != "on":
            return
        fingerprint = subprocess.run(["kreadconfig6", "--file", "kscreenlockerrc", "--group", "Authenticators",
                                      "--key", "Fingerprint"], capture_output=True, text=True, timeout=10).stdout.strip()
        if fingerprint or ask_service("has-fingerprint", getpass.getuser()) not in ("0", "14"):
            return
        subprocess.run(["kwriteconfig6", "--file", "kscreenlockerrc", "--group", "Authenticators", "--key", "Fingerprint",
                        "true"], timeout=10)
    except (OSError, subprocess.SubprocessError):
        pass


def forget_stale_choices(state: str) -> None:
    """Once per user: earlier versions of the settings page wrote Face=false and Fingerprint=false
    into kscreenlockerrc whenever a method was off for the whole system. Left there, they keep the
    lock screen's buttons away after the method is on again, such as after reinstalling. Later
    choices are kept: the settings page now leaves "off" unset."""
    marker = os.path.join(state, "lockscreen-choices-reset")
    if os.path.exists(marker):
        return
    try:
        for method in ("Face", "Fingerprint"):
            value = subprocess.run(["kreadconfig6", "--file", "kscreenlockerrc", "--group", "Authenticators", "--key", method],
                                   capture_output=True, text=True, timeout=10).stdout.strip()
            if value == "false":
                subprocess.run(["kwriteconfig6", "--file", "kscreenlockerrc", "--group", "Authenticators", "--key", method,
                                "--delete"], timeout=10)
        os.makedirs(state, exist_ok=True)
        open(marker, "w").close()
    except (OSError, subprocess.SubprocessError):
        pass


def main() -> int:
    state = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"), "kenning")
    forget_stale_choices(state)
    enable_face_method()
    enable_fingerprint_method()
    marker = os.path.join(state, "setup-prompted")
    if os.path.exists(marker):
        return 0

    def done() -> None:
        os.makedirs(state, exist_ok=True)
        open(marker, "w").close()

    enrolled = has_face_model(getpass.getuser())
    if enrolled is None:
        return 0
    if enrolled:
        done()
        return 0
    # Only right after the computer starts, like a welcome.
    with open("/proc/uptime") as uptime:
        if float(uptime.read().split()[0]) >= MAX_UPTIME:
            return 0
    if not has_ir_camera():
        # Ask again on a later startup, in case an IR camera is plugged in.
        return 0

    time.sleep(15)
    done()
    result = subprocess.run(
        ["notify-send", "--app-name=Face & Fingerprint", "--icon=user-identity", "--action=setup=Set Up",
         "Sign in with your face",
         "This computer has an infrared camera that can recognize you on the login and lock screens."],
        capture_output=True, text=True)
    if result.stdout.strip() == "setup":
        os.execvp("systemsettings", ["systemsettings", "kcm_kenning"])
    return 0


if __name__ == "__main__":
    sys.exit(main())
