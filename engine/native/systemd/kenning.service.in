[Unit]
Description=Face unlock service
Requires=kenning.socket

[Service]
ExecStart=@KENNING_BINARY@ daemon
# Not root: it decodes frames from a USB device.
User=@KENNING_SERVICE_USER@
Group=@KENNING_SERVICE_USER@
SupplementaryGroups=video
RuntimeDirectory=kenning
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
DevicePolicy=closed
DeviceAllow=char-video4linux rw
CapabilityBoundingSet=
NoNewPrivileges=yes
ProtectSystem=strict
# Set Up saves face models here; nothing else on the system is writable
ReadWritePaths=-@KENNING_SYSCONFDIR@/models
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
