[Domain]
Name=Face & Fingerprint
Icon=user-identity

[org.kde.kcontrol.kcmkenning.list]
Name=List face models
Description=Read your saved face models
Policy=yes

[org.kde.kcontrol.kcmkenning.add]
Name=Add a face model
Description=Authentication is required to save a new face model
Policy=auth_admin
Persistence=session

[org.kde.kcontrol.kcmkenning.remove]
Name=Remove a face model
Description=Authentication is required to remove a face model
Policy=auth_admin
Persistence=session

[org.kde.kcontrol.kcmkenning.save]
Name=Save face and fingerprint settings
Description=Authentication is required to change face and fingerprint unlock settings
Policy=auth_admin
Persistence=session

[org.kde.kcontrol.kcmkenning.installtheme]
Name=Install a face unlock theme
Description=Authentication is required to install a theme. Themes run on the login and lock screens, so only install themes you trust.
Policy=auth_admin
Persistence=session

[org.kde.kcontrol.kcmkenning.removetheme]
Name=Remove a face unlock theme
Description=Authentication is required to remove a theme
Policy=auth_admin
Persistence=session
